<Page x:Class="LendingServices.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="1100"
      Background="#F5F7FB">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="109*"/>
            <RowDefinition Height="320*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">

            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="CornerRadius" Value="15"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="BorderBrush" Value="#B5DCF0"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UniformGrid.Resources>

            <Border>
                <StackPanel>
                    <TextBlock Text="Total Outstanding" FontSize = "15" Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalOutstanding, StringFormat='₱{0:N2}'}" FontSize="30"  FontWeight="Bold" Foreground="#FF61C6E8"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="#FFFB9393">
                <StackPanel>
                    <TextBlock Text="Overdue Customers" FontSize = "15" Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OverdueCustomersCount}" FontSize="30" Foreground="Red" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="#FFFCF09F">
                <StackPanel>
                    <TextBlock Text="Due This Week" FontSize = "15" Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DueThisWeekCount}" FontSize="30" Foreground="#F59E0B" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="#FFB1F6B9">
                <StackPanel>
                    <TextBlock Text="Daily Receipts" FontSize = "15" Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DailyReceipts, StringFormat='₱{0:N2}'}" FontSize="30" Foreground="Green" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Margin="5"
        Padding="15"
        CornerRadius="15"
        Background="AliceBlue"
        BorderBrush="#FFF18F89"
        BorderThickness="2">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Overdue Customers" FontSize="20" Foreground="#EF4444" FontWeight="Bold"/>

                    <ScrollViewer MaxHeight="220" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OverdueCustomersList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Foreground="#B91C1C" 
                               VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Balance, StringFormat='₱{0:N2}'}" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               Foreground="#EF4444"
                               Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
        Margin="5"
        Padding="15"
        CornerRadius="15"
        Background="White"
        BorderBrush="#FFC1D4EE"
        BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Daily Receipts Trend" FontSize="20" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                    <lvc:CartesianChart Series="{Binding ReceiptsSeries}"
                            XAxes="{Binding XAxes}"
                            Height="240" 
                            Margin="0,10,0,0"
                            DrawMarginFrame="{x:Null}">
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</Page>