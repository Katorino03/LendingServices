<Page x:Class="LendingServices.Views.DailyCollection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="DailyCollection"
      Width="1100"
      Height="500">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FB" Offset="0"/>
            <GradientStop Color="#E8ECF5" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid Background="#F5F7FB" Margin="20">
        <Border Background="#F5F7FB"
                CornerRadius="18"
                Padding="20"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Daily Collection Sheet"
                           FontSize="26"
                           FontWeight="Bold" Foreground="#FF0C2794"/>
                <TextBlock Text="Record daily payments from customers"
                           Foreground="Gray"
                           Margin="0,5,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="15" Margin="5"
                            BorderBrush="#B5DCF0" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtCollectibles"
                                   Text="₱ 0"
                                   Foreground="#2563EB"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="15" Margin="5" Grid.Column="1"
                            BorderBrush="#B5DCF0" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtTotalCollection"
                                   Text="₱ 0"
                                   Foreground="#10B981"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="15" Margin="5" Grid.Column="2"
                            BorderBrush="#B5DCF0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtNetCollection"
                                   Text="₱ 0"
                                   Foreground="#F59E0B"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <DataGrid x:Name="dgCustomers"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Margin="0,0,0,20"
                          HeadersVisibility="Column"
                          RowHeight="35"
                          FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Account No." Binding="{Binding AccountNo}" Width="100"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Daily Payment" Binding="{Binding DailyPayment}" Width="120"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="120"/>
                        <DataGridTextColumn Header="Amount Paid Today"
                                            Binding="{Binding AmountPaidToday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Border Background="#2563EB"
            CornerRadius="12"
            Padding="5"
            Margin="5"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.25"/>
                        </Border.Effect>
                        <Button Content="Record Collection"
                Width="180"
                Height="40"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                Click="RecordCollection_Click"/>
                    </Border>

                    <Border Background="Gray"
            CornerRadius="12"
            Padding="5"
            Margin="5"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.25"/>
                        </Border.Effect>
                        <Button Content="Preview and Print"
                Width="180"
                Height="40"
                Background="Gray"
                Foreground="White"
                BorderThickness="0"
                Click="PreviewPrint_Click"/>
                    </Border>

                    <Border Background="#E5E7EB"
            CornerRadius="12"
            Padding="5"
            Margin="5"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.25"/>
                        </Border.Effect>
                        <Button Content="Clear All"
                Width="120"
                Height="40"
                Background="#E5E7EB"
                BorderThickness="0"
                Click="ClearAll_Click"/>
                    </Border>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
