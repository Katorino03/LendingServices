<Page x:Class="LendingServices.Views.DailyCollection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Daily Collection"
      Width="1200">
    <Page.Background>
        <SolidColorBrush Color="#F4F9FB"/>
    </Page.Background>

    <Grid VerticalAlignment="Stretch">

        <Border Width="1150"
                Margin="20"
                Padding="30,30,30,20" 
                CornerRadius="25"
                Background="White"
                BorderBrush="#B5DCF0"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled" 
                          Padding="0,0,10,0">

                <StackPanel Margin="0,0,0,40">

                    <Grid Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="Daily Collection" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="#172554"/>
                            <TextBlock Text="Record payments, manage expenses, and track daily releases" 
                                       Foreground="#4B5563" 
                                       FontSize="16" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Background="#E0F2FE" CornerRadius="12" Padding="15,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='MMMM dd, yyyy'}" 
                                           FontWeight="SemiBold" Foreground="#1E40AF"
                                           xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Background="#F8FAFC" BorderBrush="#D8EDF8" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Collectibles" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCollectibles, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#172554" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="4,0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Total Collection" FontSize="13" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCollection, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="4,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Addl. Release" FontSize="13" FontWeight="SemiBold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AdditionalRelease, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Margin="4,0" Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Expenses" FontSize="13" FontWeight="SemiBold" Foreground="#9A3412" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Expenses, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Margin="8,0,0,0" Background="#E0F2FE" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Net Collection" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NetCollection, StringFormat='₱ {0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Customer Payment List" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9" Margin="0,0,0,15"/>

                    <Border Background="#FAFCFD" CornerRadius="20" Padding="10" BorderBrush="#D8EDF8" BorderThickness="1.5" Margin="0,0,0,25">
                        <DataGrid x:Name="dgCustomers"
                                  ItemsSource="{Binding Customers}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="45"
                                  FontSize="15"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#D8EDF8"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Acc No." Binding="{Binding AccountNo}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Daily Requirement" Binding="{Binding DailyPayment, StringFormat='N2'}" Width="150" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Amount Paid Today" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#B5DCF0" BorderThickness="1" CornerRadius="8" Margin="5,2" Height="32">
                                                <TextBox Text="{Binding AmountPaidToday, UpdateSourceTrigger=PropertyChanged}" 
                                                         BorderThickness="0" Background="Transparent" 
                                                         VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Additional Release" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <Border Background="White" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                <ui:TextBox Text="{Binding AdditionalReleaseInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Daily Expenses" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <Border Background="White" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                <ui:TextBox Text="{Binding ExpensesInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,25" Background="#E2E8F0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear All" Width="130" Height="48" Margin="0,0,15,0" Background="#E5E7EB" Foreground="#4B5563" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Command="{Binding ClearAllCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Preview &amp; Print" Width="180" Height="48" Margin="0,0,15,0" Background="#172554" Foreground="White" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="PreviewPrint_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="240" Height="48" Background="#5B9FC9" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding RecordCollectionCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Record Collection" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>