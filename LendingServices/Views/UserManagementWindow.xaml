<Window x:Class="LendingServices.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management" Width="450"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="20" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.2" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="User Management" FontSize="24" FontWeight="Bold" Foreground="#0C2794"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="18" 
                            Cursor="Hand" Click="CloseModal_Click"/>
                </Grid>

                <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="12" Padding="4" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnMyProfileTab" Grid.Column="0" Content="My Profile" 
                                Click="Tab_Click" Tag="Profile" Height="35" FontSize="14" Padding="5,0"
                                Style="{StaticResource ModernNavButton}" BorderThickness="0"/>

                        <Button x:Name="btnCreateAccountTab" Grid.Column="1" Content="New Client" 
                                Click="Tab_Click" Tag="Create" Height="35" FontSize="14" Padding="5,0"
                                Style="{StaticResource ModernNavButton}" BorderThickness="0"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <StackPanel>

                        <TextBlock x:Name="txtSectionTitle" Text="Edit My Information" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,15"/>

                        <TextBlock Text="Full Name" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFullName" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                                 Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

                        <TextBlock Text="Username" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtUsername" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                                 Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

                        <Border Height="1" Background="#F1F5F9" Margin="0,10,0,20"/>
                        <TextBlock Text="SECURITY SETTINGS" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,10"/>

                        <TextBlock Text="Security Question" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSecurityQuestion" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15" Background="#F8FAFC" BorderBrush="#E2E8F0">
                            <ComboBoxItem Content="What was the name of your first pet?"/>
                            <ComboBoxItem Content="What is your mother's maiden name?"/>
                            <ComboBoxItem Content="What was the name of your elementary school?"/>
                            <ComboBoxItem Content="In what city were you born?"/>
                            <ComboBoxItem Content="What was the make of your first car?"/>
                            <ComboBoxItem Content="What is your favorite book?"/>
                            <ComboBoxItem Content="What was the name of your first boss?"/>
                            <ComboBoxItem Content="In what city did your parents meet?"/>
                        </ComboBox>

                        <TextBlock Text="Security Answer" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSecurityAnswer" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                                 Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

                        <Border Height="1" Background="#F1F5F9" Margin="0,10,0,20"/>
                        <TextBlock x:Name="lblPassword" Text="Change Password" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtPassword" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                                     Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

                        <TextBlock Text="Confirm Password" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtConfirmPassword" Height="40" VerticalContentAlignment="Center" Padding="10,0" 
                                     Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="3" x:Name="btnSubmit" Content="Save Changes" Height="45" 
                        Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold" 
                        Margin="0,15,0,0" Cursor="Hand" Click="btnSubmit_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>