<Window x:Class="LendingServices.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">

    <Grid>
        
        <Border CornerRadius="25"
                Background="#80FFFFFF"
                BorderBrush="#B5DCF0"
                BorderThickness="1.5"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

               
                <Border Background="#D8EDF8"
                        CornerRadius="20,0,0,20"
                        Padding="30" Margin="0,0,13,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        
                        <Border Width="90" Height="90"
                                Background="#99FFFFFF"
                                CornerRadius="20"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <TextBlock Text=" "
                                       FontSize="40"
                                       Foreground="#5B9FC9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        
                        <TextBlock Text="Ang Cool"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#172554"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Lending Services"
                                   FontSize="18"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="280"
                           >

                   
                    <TextBlock Text="Welcome Back!"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172554"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to continue"
                               FontSize="14"
                               Foreground="#4B5563"
                               HorizontalAlignment="Center"/>

                   
                    <TextBlock Text="Username"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Border Background="#40FFFFFF"
                            BorderBrush="#B5DCF0"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤"
                                       FontSize="16"
                                       Foreground="#5B9FC9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txtUsername"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Foreground="#111827"/>
                        </Grid>
                    </Border>

                    
                    <TextBlock Text="Password"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Border Background="#40FFFFFF"
                            BorderBrush="#B5DCF0"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔐"
                                       FontSize="16"
                                       Foreground="#5B9FC9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <PasswordBox x:Name="txtPassword"
                                         Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="👁"
                                    FontSize="12"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ShowPassword_Click"/>
                        </Grid>
                    </Border>

                    
                    <Button Height="45"
                            Background="#5B9FC9"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Login_Click"
                            Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Sign In"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
