<Window x:Class="LendingServices.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=txtUsername}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">


    <Grid>

        <Border CornerRadius="25"
                Background="White"
                BorderBrush="#B5DCF0"
                BorderThickness="1.5"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>


                <Border Background="#D8EDF8"
                        CornerRadius="20,20,20,20"
                        Padding="30" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <Border Width="90" Height="90"
                                Background="White"
                                CornerRadius="20"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <Image Source="/Images/AngCoolLogo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased"
                                    Margin="1" 
                                    Stretch="Uniform"/>
                        </Border>


                        <TextBlock Text="Ang Cool"
                                   FontSize="32"
                                   Foreground="#172554"
                                   HorizontalAlignment="Center" FontWeight="Black"/>
                        <Border Background="#172554" CornerRadius="6" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="LENDING SERVICES"
                                   FontSize="11"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" Background="#172554"/>
                        </Border>
                    </StackPanel>
                </Border>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="280"
                           >


                    <TextBlock Text="Welcome Back!"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172554"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="Sign in to continue"
                               FontSize="14"
                               Foreground="#4B5563"
                               HorizontalAlignment="Center"/>


                    <TextBlock Text="Username"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,25,0,8"/>
                    <Border Background="#40FFFFFF"
                            BorderBrush="#B5DCF0"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤"
                                       FontSize="16"
                                       Foreground="#5B9FC9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txtUsername"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Foreground="#111827"/>
                        </Grid>
                    </Border>


                    <TextBlock Text="Password"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,15,0,8"/>
                    <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔐" FontSize="16" Foreground="#5B9FC9" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <TextBox x:Name="txtPasswordReveal"
                                     Grid.Column="1"
                                     Visibility="Collapsed" 
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>

                            <PasswordBox x:Name="txtPassword"
                                         Grid.Column="1"
                                         Visibility="Visible"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"/>

                            <Button x:Name="btnShowPassword"
                                    Grid.Column="2"
                                    Content="👁"
                                    FontSize="12"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ShowPassword_Click"/>
                        </Grid>
                    </Border>


                    <Button Height="45"
                            Background="#5B9FC9"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsDefault="True"
                            Click="Login_Click"
                            Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Sign In"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center">
                            <Hyperlink Foreground="#5B9FC9" Click="ForgotPassword_Click" TextDecorations="None">
                                Forgot Password?
                            </Hyperlink>
                    </TextBlock>

                </StackPanel>
                <Button HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Content="✕" 
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#9CA3AF" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="0,-10,0,0"
                        Click="CloseButton_Click" Grid.Column="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
