<Page x:Class="LendingServices.Views.PrintPreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="1200"
      Background="#F5F6FA">

    <Grid Margin="20">
        <Border x:Name="printArea"
                Background="#F5F7FB"
                CornerRadius="18"
                Padding="20"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>


                <TextBlock x:Name="txtDate"
                               DockPanel.Dock="Right"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgLeft"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              Grid.Column="0"
                              Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name of Customer" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DailyPayment}" Width="80"/>
                            <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaidToday}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="dgRight"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              Grid.Column="1"
                              Margin="10,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name of Customer" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DailyPayment}" Width="80"/>
                            <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaidToday}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Margin="0,10,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="10" Margin="5"
                            BorderBrush="#B5DCF0" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtCollectibles" FontWeight="Bold"/>
                    </Border>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="10" Margin="5" Grid.Column="1"
                            BorderBrush="#B5DCF0" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock Text="ADDITIONAL RELEASE:" FontWeight="Bold"/>
                    </Border>

                    <Border Background="AliceBlue" CornerRadius="10" Padding="10" Margin="5" Grid.Column="2"
                            BorderBrush="#B5DCF0" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock x:Name="txtNet" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="250"/>
                        <TextBlock Text="Prepared by:" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="250"/>
                        <TextBlock Text="Received by:" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Background="#2563EB"
        CornerRadius="12"
        Padding="5"
        Margin="30,30,0,0"
        BorderBrush="#40FFFFFF"
        BorderThickness="1"
        HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.25"/>
                    </Border.Effect>

                    <Button Content="Print"
            Width="120"
            Height="40"
            Background="#2563EB"
            Foreground="White"
            BorderThickness="0"
            Click="PrintNow_Click"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Page>
