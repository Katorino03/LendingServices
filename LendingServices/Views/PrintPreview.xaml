<Page x:Class="LendingServices.Views.PrintPreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="500"
      d:DesignWidth="1200">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EEF2FF" Offset="0"/>
            <GradientStop Color="#F8FAFC" Offset="0.5"/>
            <GradientStop Color="#E0F2FE" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid Margin="20">

        <Ellipse Width="650"
                 Height="650"
                 Fill="#3B82F6"
                 Opacity="0.08"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-220,-220,0,0"/>

        <Ellipse Width="500"
                 Height="500"
                 Fill="#8B5CF6"
                 Opacity="0.06"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"/>

        <Border x:Name="printArea"
                CornerRadius="28"
                Padding="0"
                Background="#CCFFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="35">

                <StackPanel>

                  
                    <Grid Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Print Preview"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Review and print collection report"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       Foreground="#64748B"/>
                        </StackPanel>

                      
                        <Border Grid.Column="1"
                                Background="#FF73DAF6"
                                CornerRadius="14"
                                Padding="18,10"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                VerticalAlignment="Top">

                            <TextBlock x:Name="txtDate"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                        </Border>

                    </Grid>


                    
                    <Grid Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                       
                        <Border Grid.Column="0"
                                Margin="0,0,10,0"
                                CornerRadius="20"
                                Padding="18"
                                Background="#FFC4EDFB"
                                BorderBrush="#FF73DAF6"
                                BorderThickness="1">

                            <DataGrid x:Name="dgLeft"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="None"
                                      RowHeight="40">

                                <DataGrid.Resources>

                                    
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Height" Value="42"/>
                                    </Style>

                                    
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10"/>
                                    </Style>

                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Customer"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding DailyPayment}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Amount"
                                                        Binding="{Binding AmountPaidToday}"
                                                        Width="130"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>


                        
                        <Border Grid.Column="1"
                                Margin="10,0,0,0"
                                CornerRadius="20"
                                Padding="18"
                                Background="#FFC4EDFB"
                                BorderBrush="#FF73DAF6"
                                BorderThickness="1">

                            <DataGrid x:Name="dgRight"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="None"
                                      RowHeight="40">

                                <DataGrid.Resources>

                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Height" Value="42"/>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10"/>
                                    </Style>

                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Customer"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding DailyPayment}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Amount"
                                                        Binding="{Binding AmountPaidToday}"
                                                        Width="130"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </Grid>


                  
                    <Grid Margin="0,0,0,30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        
                        <Border Grid.Column="0"
                                Margin="0,0,10,0"
                                Background="#FFEDFCFC"
                                CornerRadius="18"
                                Padding="20"
                                BorderBrush="#FF7BDAEE"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Collectibles"
                                           FontSize="13"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtCollectibles"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>

                        <!-- Additional -->
                        <Border Grid.Column="1"
                                Margin="5,0"
                                Background="#FFE9FEE5"
                                CornerRadius="18"
                                Padding="20"
                                BorderBrush="#FF6AF98A"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Additional Release"
                                           FontSize="13"
                                           Foreground="#64748B"/>

                                <TextBlock Text="₱ 0.00"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                       
                        <Border Grid.Column="2"
                                Margin="10,0,0,0"
                                Background="#FFFAECFB"
                                CornerRadius="18"
                                Padding="20"
                                BorderBrush="#FFC35DF3"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Net Collection"
                                           FontSize="13"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtNet"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                    </Grid>


                    
                    <Grid Margin="0,15,0,35">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                       
                        <StackPanel>

                            <Border Width="260"
                                    BorderBrush="#64748B"
                                    BorderThickness="0,0,0,1"
                                    HorizontalAlignment="Center"/>

                            <TextBlock Text="Prepared by"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <Border Width="260"
                                    BorderBrush="#64748B"
                                    BorderThickness="0,0,0,1"
                                    HorizontalAlignment="Center"/>

                            <TextBlock Text="Received by"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>


                    
                    <Button Content="Print Report"
                            Width="180"
                            Height="48"
                            HorizontalAlignment="Left"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PrintNow_Click">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>