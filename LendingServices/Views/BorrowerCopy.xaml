<Page x:Class="LendingServices.Views.BorrowerCopy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="BorrowerCopy"
      Width="794"
      Height="1123"
      Background="#E5E7EB">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="20">

       
        <Border Width="794"
                Height="1123"
                Background="White"
                Padding="40"
                BorderBrush="#D1D5DB"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.15"/>
            </Border.Effect>

           
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                   
                    <TextBlock Text="Borrower Ledger Copy"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Payment record and loan details"
                               Foreground="#64748B"
                               Margin="0,4,0,25"/>

                   
                    <Border Background="#F8FAFC"
                            CornerRadius="14"
                            Padding="18"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Margin="0,0,0,20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Account No.: {Binding AccountNo}"
                                           Foreground="#64748B"/>
                                <TextBlock Text="Address: {Binding Address}"
                                           Foreground="#64748B"/>
                                <TextBlock Text="Contact #: {Binding Contact}"
                                           Foreground="#64748B"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Loan Amount: ₱{Binding LoanAmount}"
                                           Foreground="#334155"/>

                                <TextBlock Text="Daily Payment: ₱{Binding DailyPayment}"
                                           Foreground="#334155"/>

                                <TextBlock Text="Terms: {Binding Terms} days"
                                           Foreground="#334155"/>

                                <TextBlock Text="Date Loaned: {Binding DateLoaned, StringFormat='MMMM dd, yyyy'}"
                                           Foreground="#334155"/>

                                <TextBlock Text="Due Date: {Binding DueDate, StringFormat='MMMM dd, yyyy'}"
                                           Foreground="#334155"/>

                            </StackPanel>
                        </Grid>
                    </Border>

                   
                    <Border Background="White"
                            CornerRadius="14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,20">

                        <DataGrid x:Name="dgLedger"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="30"
                                  FontSize="13"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="60"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='MM/dd/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="120"/>
                                <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="200"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Border>

                   
                    <Border Background="#F8FAFC"
                            CornerRadius="14"
                            Padding="18"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock Text="Total Loan: ₱{Binding LoanAmount}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Total Paid: ₱{Binding TotalPaid}"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Balance: ₱{Binding Balance}"
                                       FontWeight="SemiBold"
                                       Foreground="#EF4444"
                                       Margin="0,5,0,0"/>

                        </StackPanel>
                    </Border>

                   
                    <Grid Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border BorderBrush="#94A3B8"
                                    BorderThickness="0,0,0,1"
                                    Width="240"/>
                            <TextBlock Text="Borrower's Signature"
                                       HorizontalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border BorderBrush="#94A3B8"
                                    BorderThickness="0,0,0,1"
                                    Width="240"/>
                            <TextBlock Text="Date"
                                       HorizontalAlignment="Center"
                                       Foreground="#64748B"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                    </Grid>

                    
                    <TextBlock Text=""
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,30,0,0"
                               HorizontalAlignment="Center"/>

                  
                    <Button Content="Print"
                            Width="140"
                            Height="42"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Foreground="White"
                            BorderThickness="0"
                            Click="PrintNow_Click">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB"/>
                                <GradientStop Color="#7C3AED"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                </StackPanel>
            </ScrollViewer>

        </Border>
    </Grid>
</Page>