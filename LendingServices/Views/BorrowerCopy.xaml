<Page x:Class="LendingServices.Views.BorrowerCopy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BorrowerCopy"
      Width="794" Height="1123"
      Background="#F3F4F6">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">

                <!-- Header -->
                <TextBlock Text="Borrower Ledger Copy"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Payment record and loan details"
                           Foreground="#64748B"
                           FontSize="16"
                           Margin="0,2,0,20"/>

                <!-- Borrower Info -->
                <Border Background="#F9FAFB" CornerRadius="10" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Account No.: {Binding AccountNo}" Foreground="#6B7280" FontSize="13"/>
                            <TextBlock Text="Address: {Binding Address}" Foreground="#6B7280" FontSize="13"/>
                            <TextBlock Text="Contact #: {Binding Contact}" Foreground="#6B7280" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Loan Amount: ₱{Binding LoanAmount}" Foreground="#374151" FontSize="13"/>
                            <TextBlock Text="Daily Payment: ₱{Binding DailyPayment}" Foreground="#374151" FontSize="13"/>
                            <TextBlock Text="Terms: {Binding Terms} days" Foreground="#374151" FontSize="13"/>
                            <TextBlock Text="Date Loaned: {Binding DateLoaned, StringFormat='MMMM dd, yyyy'}" Foreground="#374151" FontSize="13"/>
                            <TextBlock Text="Due Date: {Binding DueDate, StringFormat='MMMM dd, yyyy'}" Foreground="#374151" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Ledger Table -->
                <DataGrid x:Name="dgLedger"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeight="28"
                          FontSize="14"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F9FAFB"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="60"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='MM/dd/yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="120"/>
                        <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Totals -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Total Loan: ₱{Binding LoanAmount}" FontWeight="Bold" FontSize="15" Foreground="#111827"/>
                    <TextBlock Text="Total Paid: ₱{Binding TotalPaid}" FontWeight="Bold" FontSize="15" Foreground="#10B981"/>
                    <TextBlock Text="Balance: ₱{Binding Balance}" FontWeight="Bold" FontSize="15" Foreground="#EF4444"/>
                </StackPanel>

                <!-- Signature Lines -->
                <Grid Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border BorderBrush="#9CA3AF" BorderThickness="0,0,0,1" Width="240"/>
                        <TextBlock Text="Borrower's Signature" HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border BorderBrush="#9CA3AF" BorderThickness="0,0,0,1" Width="240"/>
                        <TextBlock Text="Date" HorizontalAlignment="Center" Foreground="#6B7280" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <TextBlock Text="This is a computer-generated document. Print for borrower's record."
                           FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Print Button -->
                <Button x:Name="btnPrint"
                        Width="122" Height="43"
                        HorizontalAlignment="Right"
                        Foreground="White" BorderThickness="0"
                        Click="PrintNow_Click"
                        FontSize="15" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB"/>
                            <GradientStop Color="#7C3AED"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="12,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🖨" FontSize="20" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Print" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
