<Page x:Class="LendingServices.Views.BorrowerCopy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Borrower Ledger Copy"
      Width="1100" Height="auto">

    <Page.Background>
        <SolidColorBrush Color="#F4F9FB"/>
    </Page.Background>

    <Grid>
        <Border Width="1000" Margin="30" Padding="40" CornerRadius="25"
                Background="White" BorderBrush="#B5DCF0" BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Top">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel>

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Borrower Ledger Copy" FontSize="28" FontWeight="Bold" Foreground="#172554"/>
                            <TextBlock Text="Official payment record and loan amortization schedule" Foreground="#4B5563" FontSize="16" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnPrint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="150" Height="45" Background="#172554" Foreground="White"
                                FontSize="16" FontWeight="SemiBold" Click="PrintNow_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🖨" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Print Ledger" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Background="#F8FAFC" CornerRadius="15" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 Search Customer:" FontSize="16" FontWeight="SemiBold" Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <ComboBox Width="350" Height="35"
                                      IsEditable="True"
                                      ItemsSource="{Binding CustomerList}"
                                      SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="CustomerName"
                                      FontSize="15" Padding="5"
                                      ToolTip="Type a name to search or click the dropdown"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Loan Information" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9" Margin="0,0,0,15"/>
                    <Border Background="#FAFCFD" CornerRadius="20" Padding="25" BorderBrush="#D8EDF8" BorderThickness="1.5" Margin="0,0,0,30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Account No: " Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AccountNo}" Foreground="#1E3A8A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Address: " Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Address}" Foreground="#4B5563"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Contact: " Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Contact}" Foreground="#4B5563"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Date Loaned:" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DateLoaned, StringFormat='MMM dd, yyyy'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#172554"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Due Date:" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DueDate, StringFormat='MMM dd, yyyy'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                    </Grid>
                                    <Separator Margin="0,8" Background="#E2E8F0"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Daily Payment:" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding DailyPayment, StringFormat='₱ {0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#15803D"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Payment Schedule &amp; History" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9" Margin="0,0,0,15"/>
                    <Border Background="White" CornerRadius="20" Padding="10" BorderBrush="#D8EDF8" BorderThickness="1.5" Margin="0,0,0,25">
                        <DataGrid x:Name="dgLedger" ItemsSource="{Binding LedgerItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeight="40" FontSize="15" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7" BorderThickness="0">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#D8EDF8"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="80"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='MM/dd/yyyy'}" Width="150"/>
                                <DataGridTextColumn Header="Principal" Binding="{Binding Principal, StringFormat='₱ {0:N2}'}" Width="*"/>

                                <DataGridTemplateColumn Header="Signed" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="Bold" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="NO"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                                                    <Setter Property="Text" Value="YES"/>
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Margin="0,10,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,10,0" Background="#F8FAFC" BorderBrush="#D8EDF8" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Total Loan Amount" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LoanAmount, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#172554" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="5,0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Total Amount Paid" FontSize="13" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPaid, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="10,0,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="18" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Remaining Balance" FontSize="13" FontWeight="SemiBold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Balance, StringFormat='₱ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Background="#E2E8F0" Margin="0,0,0,20"/>

                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Borrower's Signature" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,40"/>
                            <Border BorderBrush="#94A3B8" BorderThickness="0,1,0,0" Width="250"/>
                            <TextBlock Text="{Binding Name, FallbackValue='Customer Name'}" HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Released By" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,40"/>
                            <Border BorderBrush="#94A3B8" BorderThickness="0,1,0,0" Width="250"/>
                            <TextBlock Text="Authorized Signature" HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>