<Window x:Class="LendingServices.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        Width="400"
        Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <Border CornerRadius="25"
                Background="White"
                BorderBrush="#B5DCF0"
                BorderThickness="1.5"
                Padding="30"
                Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Button HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Content="✕" 
                        FontSize="16" 
                        Foreground="#9CA3AF" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="0,-15,-15,0"
                        Click="CloseButton_Click"/>

                <StackPanel x:Name="Step1Panel" VerticalAlignment="Center" Visibility="Visible">

                    <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Forgot Password?"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172554"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Enter your username to find your account."
                               FontSize="14"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,5,0,25"/>

                    <TextBlock Text="Username" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" FontSize="16" Foreground="#5B9FC9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtRecoveryUsername" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="14" VerticalContentAlignment="Center" Foreground="#111827"/>
                        </Grid>
                    </Border>

                    <Button Content="Find Account" Height="45" Background="#5B9FC9" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,25,0,0" Click="FindAccount_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="Step2Panel" VerticalAlignment="Center" Visibility="Collapsed">

                    <TextBlock Text="🛡️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Security Verification"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172554"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Answer your security question to reset."
                               FontSize="14"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,5,0,20"/>

                    <TextBlock x:Name="txtSecurityQuestion" FontSize="14" FontWeight="Bold" Foreground="#172554" TextWrapping="Wrap" Margin="0,0,0,8" Text="Question goes here?"/>

                    <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="40" Margin="0,0,0,15">
                        <TextBox x:Name="txtSecurityAnswer" BorderThickness="0" Background="Transparent" FontSize="14" VerticalContentAlignment="Center" Foreground="#111827" Padding="10,0"/>
                    </Border>

                    <TextBlock Text="New Password" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="40">
                        <PasswordBox x:Name="txtNewPassword" BorderThickness="0" Background="Transparent" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
                    </Border>

                    <Button Content="Reset Password" Height="45" Background="#16A34A" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,25,0,0" Click="ResetPassword_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Cancel" Background="Transparent" Foreground="#4B5563" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>