<Page x:Class="LendingServices.Views.AddCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AddCustomer">

    <Page.Background>
        <SolidColorBrush Color="#F4F9FB"/>
    </Page.Background>

    <Grid>
        <Border Width="1000"
                Margin="20"
                Padding="40"
                CornerRadius="25"
                Background="White"
                BorderBrush="#B5DCF0"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel>

                    <TextBlock Text="Customer Registration" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#172554" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Create a new loan profile and customer record below" 
                               Foreground="#4B5563" 
                               FontSize="16" 
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Personal Details" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9" Margin="0,0,0,15"/>

                    <Border Background="#FAFCFD" CornerRadius="20" Padding="25" BorderBrush="#D8EDF8" BorderThickness="1.5" Margin="0,0,0,30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,0,15" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Account Number" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 407" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="15,0,0,15">
                                <TextBlock Text="Full Name" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Juan Dela Cruz" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,15,0">
                                <TextBlock Text="Complete Address" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Street, Barangay, City" BorderThickness="0" Background="Transparent" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Contact Number" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="09XXXXXXXXX" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Loan Configuration" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9" Margin="0,0,0,15"/>

                    <Border Background="#FAFCFD" CornerRadius="20" Padding="25" BorderBrush="#D8EDF8" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Date Loaned" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <DatePicker SelectedDate="{Binding DateLoaned, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,20" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Terms (Days)" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 60" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Loan Type" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ComboBox SelectedValue="{Binding SelectedLoanType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" SelectedIndex="0" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#111827" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Normal" Tag=""/>
                                        <ComboBoxItem Content="Renew" Tag="Renew"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Loan Amount (₱)" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding LoanAmount, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="5000" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,20" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Interest Rate (%)" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <ui:TextBox Text="{Binding InterestRate, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 5" BorderThickness="0" Background="Transparent" FontSize="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" HorizontalAlignment="Center" Width="280">
                                <TextBlock Text="Due Date" FontSize="14" FontWeight="Bold" Foreground="#172554" Margin="0,0,0,8"/>
                                <Border Background="#40FFFFFF" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Height="48">
                                    <DatePicker SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}" 
                                                BorderThickness="0" 
                                                Background="Transparent" 
                                                FontSize="18" 
                                                VerticalContentAlignment="Center" 
                                                Foreground="#111827"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="15,10,0,0" VerticalAlignment="Bottom" Height="55">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#D8EDF8" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Padding="10,5" Margin="0,0,5,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Daily Payment" FontSize="12" FontWeight="SemiBold" Foreground="#172554" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="₱ " FontSize="14" FontWeight="Bold" Foreground="#5B9FC9" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding DailyPayment, StringFormat='N2', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#5B9FC9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#B5DCF0" BorderThickness="1.5" CornerRadius="12" Padding="10,5" Margin="5,0,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total Collectible" FontSize="12" FontWeight="SemiBold" Foreground="#172554" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="₱ " FontSize="14" FontWeight="Bold" Foreground="#1e40af" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TotalCollectible, StringFormat='N2', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#1e40af"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                        <Button Content="Clear Form" Width="140" Height="48" Margin="0,0,15,0" Background="#E5E7EB" Foreground="#4B5563" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Command="{Binding ClearFormCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="200" Height="48" Background="#5B9FC9" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding SaveCustomerCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="➕" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Customer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>