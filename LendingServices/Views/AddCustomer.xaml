<Page x:Class="LendingServices.Views.AddCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AddCustomer">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EEF2FF" Offset="0"/>
            <GradientStop Color="#E0F2FE" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid>

        <Ellipse Width="600"
                 Height="600"
                 Fill="#3B82F6"
                 Opacity="0.10"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-200,-200,0,0"/>

        <Ellipse Width="500"
                 Height="500"
                 Fill="#8B5CF6"
                 Opacity="0.08"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"/>

        <Border Width="1050"
                Padding="35"
                CornerRadius="25"
                Background="#CCFFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="0"
                                  Opacity="0.20"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Add New Customer"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Create a loan profile and customer record"
                               Margin="0,5,0,25"
                               Foreground="#64748B"/>


                    <Border Background="#FFD5E9FB"
                            CornerRadius="18"
                            Padding="25"
                            Margin="0,0,0,20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="Account Number"
                                           Margin="0,0,0,6"
                                           Foreground="#334155"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="e.g. 407"/>
                                </Border>
                            </StackPanel>


                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                                <TextBlock Text="Customer Name"
                                           Margin="0,0,0,6"
                                           Foreground="#334155"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="Juan Dela Cruz"/>
                                </Border>
                            </StackPanel>


                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,12">
                                <TextBlock Text="Address"
                                           Margin="0,0,0,6"
                                           Foreground="#334155"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                Height="60"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="Complete address"
                                                AcceptsReturn="True"
                                                TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Contact Number"
                                           Margin="0,0,0,6"
                                           Foreground="#334155"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="09XXXXXXXXX"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>



                    <TextBlock Text="Loan Details"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"
                               Foreground="#0F172A"/>

                    <Border Background="AliceBlue"
                            CornerRadius="18"
                            Padding="25">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="Loan Amount (₱)"
                                           Margin="0,0,0,6"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding LoanAmount, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="5000"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                                <TextBlock Text="Daily Payment (₱)"
                                           Margin="0,0,0,6"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding DailyPayment, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="100"/>
                                </Border>
                            </StackPanel>


                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,12,12">
                                <TextBlock Text="Terms (Days)"
                                           Margin="0,0,0,6"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                PlaceholderText="50"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,10,0,12">
                                <TextBlock Text="Loan Type"
                                           Margin="0,0,0,6"/>

                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ComboBox SelectedValue="{Binding SelectedLoanType, UpdateSourceTrigger=PropertyChanged}" 
                                              SelectedValuePath="Tag"
                                              SelectedIndex="0"
                                              Height="42" 
                                              BorderThickness="0" 
                                              Background="Transparent" 
                                              Padding="10,0">
                                        <ComboBoxItem Content="Normal" Tag=""/>
                                        <ComboBoxItem Content="Renew" Tag="Renew"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>


                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,12,0">
                                <TextBlock Text="Date Loaned"
                                           Margin="0,0,0,6"/>

                                <DatePicker SelectedDate="{Binding DateLoaned, UpdateSourceTrigger=PropertyChanged}"
                                            Height="42"/>
                            </StackPanel>


                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,10,0,0">
                                <TextBlock Text="Due Date"
                                           Margin="0,0,0,6"/>

                                <Border Background="#F1F5F9"
                                        CornerRadius="12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <ui:TextBox Text="{Binding DueDate, StringFormat='MM/dd/yyyy'}"
                                                Height="42"
                                                BorderThickness="0"
                                                Background="#EEE"
                                                PlaceholderText="Auto-calculated"
                                                IsReadOnly="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>



                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">

                        <Button Width="162"
                                Height="48"
                                Content="Add Customer"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Command="{Binding SaveCustomerCommand}">

                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button Content="Clear Form"
                                Width="130"
                                Height="48"
                                Margin="12,0,0,0"
                                Background="#E5E7EB"
                                BorderThickness="0"
                                Command="{Binding ClearFormCommand}"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
