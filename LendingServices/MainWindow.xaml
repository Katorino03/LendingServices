<Window x:Class="LendingServices.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="AliceBlue" Offset="0"/>
            <GradientStop Color="#B5DCF0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Images/AngCoolLogo.png" 
               Height="60" Width="60" Margin="0,0,15,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="35" FontWeight="Bold" Foreground="#0C2794">
                Ang Cool Lending Services
                    </TextBlock>
                    <TextBlock Text="Manage customers, balances, and daily receipts" 
                       FontSize="16" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Hello, Admin!" FontSize="16" FontWeight="SemiBold" Foreground="#0C2794" HorizontalAlignment="Right"/>
                    <TextBlock Text="System Administrator" FontSize="12" Foreground="Gray" HorizontalAlignment="Right"/>
                </StackPanel>

                <Border Width="1" Background="#B5DCF0" Margin="0,5,15,5"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTime" FontSize="26" FontWeight="Light" Foreground="#0C2794" HorizontalAlignment="Right" Text="00:00:00 AM"/>
                    <TextBlock x:Name="txtDate" FontSize="13" Foreground="Gray" HorizontalAlignment="Right" Text="Monday, January 1, 2026"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="—" Width="35" Height="35" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand" Click="Minimize_Click"/>
                <Button Content="✕" Width="35" Height="35" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand" Click="CloseApp_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="20" Padding="10" Margin="0,10,0,20"
            Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.1" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnDashboard" Grid.Column="0" Content="Dashboard" Style="{StaticResource ModernNavButton}" Click="Dashboard_Click"/>
                <Button x:Name="btnCustomerList" Grid.Column="1" Content="Customers" Style="{StaticResource ModernNavButton}" Click="CustomerList_Click"/>
                <Button x:Name="btnAddCustomer" Grid.Column="2" Content="New Client" Style="{StaticResource ModernNavButton}" Click="AddCustomer_Click"/>
                <Button x:Name="btnDailyCollection" Grid.Column="3" Content="Collection" Style="{StaticResource ModernNavButton}" Click="DailyCollection_Click"/>
                <Button x:Name="btnBorrowerCopy" Grid.Column="4" Content="Reports" Style="{StaticResource ModernNavButton}" Click="BorrowerCopy_Click"/>

                <Button x:Name="btnSettings" Grid.Column="6" Click="Settings_Click" 
                    Style="{StaticResource ModernNavButton}" Margin="0,0,5,0">
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12c0,0.31,0.02,0.65,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.5c-1.93,0-3.5-1.57-3.5-3.5 s1.57-3.5,3.5-3.5s3.5,1.57,3.5,3.5S13.93,15.5,12,15.5z" 
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                      Width="20" Height="20" Stretch="Uniform"/>
                </Button>

                <Button x:Name="btnLogout" Grid.Column="7" Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="Logout_Click" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="2" NavigationUIVisibility="Hidden" ClipToBounds="True"/>

        <Border x:Name="DimOverlay" Grid.RowSpan="3" Background="Black" Opacity="0" Visibility="Collapsed">
            <Border.Effect>
                <BlurEffect Radius="10"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>